;;; skelfile --- Shed Project Definition -*- mode: skel; -*-
:name shed
:author ("Richard Westhaver" . "ellis@rwest.io")
:version "0.2.0"
:license "MPL"
:description "CC Shed Extensions"
:vc (:hg "https://vc.compiler.company/shed"
     (cb (:git "ssh://git@codeberg.org/c-c/shed"))
     (gh (:git "ssh://git@github.com/richardwesthaver/shed")))
:include ("slime/skelfile" "vec/skelfile" "xlib/skelfile" "wm/skelfile" "tenex/skelfile")
:rules
((upstream ()
  (labels 
   ((bump (name)
     (let ((path (directory-path (merge-pathnames name "/tmp/"))))
      (probe-delete-directory path :recursive t)
      (vc-export 
       (make-instance 'hg-repo 
        :path (if (equal name "shed") 
               (current-directory) 
               (probe-directory name)))
       path)
      (with-repo (r :path path :type :git)
       (vc-remote r :add :name "cb" :url (format nil "ssh://git@codeberg.org/c-c/~A" name))
       (vc-remote r :add :name "gh" :url (format nil "ssh://git@github.com/richardwesthaver/~A" name))
       (when (equal name "shed")
        (vc-update r)
        (vc-submodule r :add :url "https://github.com/richardwesthaver/xlib")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/wm")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/tenex")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/vec")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/bbdb")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/edi")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/basement")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/attic")
        (vc-submodule r :add :url "https://github.com/richardwesthaver/slime")
        (vc-add r ".gitmodules")
        (vc-commit r "gitmodules"))
       ;; (vc-push r :set-upstream t :remote "cb" :branch "default" :force t)
       (vc-push r :remote "gh" :branch "default" :force t))))
    (bump* (&rest subrepos)
     (dolist (s subrepos)
      (bump s))))
   (bump* "xlib" "wm" "vec" "edi" "bbdb" "slime" "tenex" "attic" "basement" "shed"))))

